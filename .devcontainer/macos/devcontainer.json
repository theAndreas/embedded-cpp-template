{
    "name": "embedded-cpp-template (macOS)",
    // The image every project made from the template gets: its Dockerfile, so that this
    // container never differs from theirs. Extensions, settings and volumes live in ../shared.
    "build": {
        "dockerfile": "../../template/.devcontainer/Dockerfile",
        "context": "../../template/.devcontainer"
    },
    // Nothing is mounted: macOS has no /tmp/.X11-unix, and its SSH agent is a launchd socket
    // that Docker Desktop and OrbStack cannot bind into a container. This variant relies on
    // VS Code's own SSH-agent forwarding, as the WSL2 one does.
    "features": {
        "./../shared": {}
    }
}
