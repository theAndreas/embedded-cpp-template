NAMESPACE="{{ namespace }}"
{%- if arduino %}
FQBN="{{ fqbn }}"
ARDUINO_CORE="{{ arduino_core }}"
ARDUINO_BOARD_URLS=""
{%- elif platformio %}
TARGETS=({{ mcu }})
BUILD_SYSTEM="platformio"
# The image of platform/avr/platformio.ini's environment avr, whose platform, board and framework
# it names, pinned.
PIO_DIR="platform/avr"
PIO_ENV="avr"
{%- else %}
TARGETS=({{ mcu }})
BUILD_SYSTEM="cmake"
CMAKE_TOOLCHAIN="cmake/toolchains/avr-gcc.cmake"
{%- if kind == 'firmware' %}
# PLATFORM names the folder of platform/ the image is built with, beside src/.
CMAKE_DEFINES=(-DPLATFORM=avr -DAVR_MCU={{ mcu }} -DAVR_F_CPU={{ f_cpu }})
{%- else %}
CMAKE_DEFINES=(-DAVR_MCU={{ mcu }} -DAVR_F_CPU={{ f_cpu }})
{%- endif %}
{%- endif %}
{%- if kind == 'firmware' %}
# An image runs as long as the part has power; there is no SelfCheck that ends for simavr.
SIMAVR_MCU=""
{%- else %}
SIMAVR_MCU="{{ simavr_mcu }}"
SIMAVR_FREQUENCY="{{ simavr_frequency }}"
{%- endif %}

{%- if kind == 'firmware' %}
# One build of the image, as avr-gcc builds it by default. A variant whose defines take other
# branches of #if, a switch for checks the firmware makes only on request, is added here and in
# TIDY_VARIANTS, its flags in variant_flags():
{%- else %}
# One build of each example, as avr-gcc builds it by default. A variant whose defines take
# other branches of #if, a switch for checks the library makes only on request, is added here
# and in TIDY_VARIANTS, its flags in variant_flags():
{%- endif %}
#
#   VARIANTS=(default checked)
#   TIDY_VARIANTS=(default checked)
#   variant_flags() {
#     case "$1" in
#       checked) echo "-D{{ macro_prefix }}_CHECK_ACCESS=1" ;;
#     esac
#   }
VARIANTS=(default)
TIDY_VARIANTS=(default)
{%- if kind == 'firmware' %}

# A firmware is gnu++17, as CMakeLists.txt compiles it; cppcheck reads C++11 unless told.
cppcheck_flags() {
  echo "--std=c++17"
}
{%- endif %}
