//
// {{ project_name }} on an AVR: a timer counts the milliseconds, and a pin
// follows what Blinker says of them. What is the AVR's lies here, what is not
// in src/, which the host tests.

#include <avr/interrupt.h>
#include <avr/io.h>
#include <stdint.h>
#include <util/atomic.h>

#include "Blinker/Blinker.h"

namespace {

// Counted up by the timer's interrupt, read by the loop; volatile, as each
// side changes it behind the other's back.
uint32_t volatile milliseconds{0};

// The milliseconds, read with interrupts off: the AVR reads 8 bits at a time,
// and the interrupt could change the other three bytes in between (AVR-2).
uint32_t Now() {
  uint32_t now{0};
  ATOMIC_BLOCK(ATOMIC_RESTORESTATE) { now = milliseconds; }
  return now;
}

#ifdef TCCR0A
// The bit of a register, as avr-libc's _BV, typed as the 8 bits it is.
constexpr uint8_t Bit(uint8_t number) {
  return static_cast<uint8_t>(1U << number);
}

// Timer 0 of a classic AVR, as the ATmega328P's, in CTC mode: a match every
// millisecond at F_CPU / 64. The light on PB5, the LED of an Uno.
void StartClock() {
  TCCR0A = Bit(WGM01);
  OCR0A = static_cast<uint8_t>((F_CPU / 64U / 1000U) - 1U);
  TIMSK0 = Bit(OCIE0A);
  TCCR0B = Bit(CS01) | Bit(CS00);
}

void StartLight() { DDRB |= Bit(DDB5); }

void SetLight(bool on) {
  if (on) {
    PORTB |= Bit(PORTB5);
  } else {
    PORTB &= static_cast<uint8_t>(~Bit(PORTB5));
  }
}
#elif defined(TCB0_CCMP)
// Timer B0 of an AVR of the megaAVR 0 or Dx series, periodic: an interrupt
// every millisecond at F_CPU / 2. The light on PA7. TCB0_CCMP rather than
// TCB0.CCMP, which avr-libc declares as a union of the word and its bytes.
void StartClock() {
  TCB0_CCMP = static_cast<uint16_t>((F_CPU / 2U / 1000U) - 1U);
  TCB0.INTCTRL = TCB_CAPT_bm;
  TCB0.CTRLA = TCB_CLKSEL_DIV2_gc | TCB_ENABLE_bm;
}

void StartLight() { PORTA.DIRSET = PIN7_bm; }

void SetLight(bool on) {
  if (on) {
    PORTA.OUTSET = PIN7_bm;
  } else {
    PORTA.OUTCLR = PIN7_bm;
  }
}
#else
// Give it a StartClock(), a StartLight() and a SetLight() for the part.
#error "main.cpp knows no timer of this part."
#endif

}  // namespace

#ifdef TCCR0A
ISR(TIMER0_COMPA_vect) { milliseconds = milliseconds + 1U; }
#else
ISR(TCB0_INT_vect) {
  TCB0.INTFLAGS = TCB_CAPT_bm;
  milliseconds = milliseconds + 1U;
}
#endif

int main() {
  StartClock();
  StartLight();
  sei();

  Blinker const blinker{1000};
  for (;;) {
    SetLight(blinker.IsOnAt(Now()));
  }
}
